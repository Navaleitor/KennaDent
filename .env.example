# Copia este archivo como ".env" y cambia las contrasenas.
# ".env" NO se sube a GitHub (esta en .gitignore).

# Base de datos
KD_DB_NOMBRE=kennadent_qa
KD_DB_ADMIN=kennadent
KD_DB_ADMIN_PASSWORD=cambiar_local
# Usuario con el que se conectara la aplicacion (respeta el aislamiento por empresa)
KD_APP_PASSWORD=cambiar_app
KD_DB_PUERTO=5433

# pgAdmin (http://localhost:5050)
KD_PGADMIN_PASSWORD=cambiar_pgadmin
KD_PGADMIN_PUERTO=5050

# Prototipo web (http://localhost:8080)
KD_WEB_PUERTO=8080
