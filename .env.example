# Copia este archivo como ".env" y cambia las contrasenas.
# ".env" NO se sube a GitHub (esta en .gitignore).

# Base de datos
KD_DB_NOMBRE=kennadent_qa
KD_DB_ADMIN=kennadent
KD_DB_ADMIN_PASSWORD=cambiar_local
# Usuario con el que se conectara la aplicacion (respeta el aislamiento por empresa)
KD_APP_PASSWORD=cambiar_app
KD_DB_PUERTO=5433

# pgAdmin (http://localhost:5050)
KD_PGADMIN_PASSWORD=cambiar_pgadmin
KD_PGADMIN_PUERTO=5050

# Prototipo web (http://localhost:8080)
KD_WEB_PUERTO=8080

# Backend Django (http://localhost:8080/api/v1/ y http://localhost:8080/admin/)
# Llave secreta: cualquier texto largo y aleatorio, distinto en cada ambiente
KD_SECRET_KEY=cambiar-esta-llave-local-por-una-larga-y-aleatoria
# 1 solo para ver errores detallados al programar; en QA y nube va en 0
KD_DEBUG=0
# Contrasena de TODOS los usuarios de demostracion (ej. demo / andrea.garza)
KD_DEMO_PASSWORD=kennadent2026
# Administrador de la plataforma (admin de Django, ve todas las empresas)
KD_ADMIN_USUARIO=admin
KD_ADMIN_PASSWORD=cambiar_admin
